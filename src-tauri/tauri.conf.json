{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "quillmd",
  "version": "0.2.4",
  "identifier": "com.bmoser.quillmd",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "quillmd",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "WYSIWYG markdown editor with native markdown persistence",
    "longDescription": "A local-first WYSIWYG markdown editor. The .md file on disk is the only source of truth: no cloud, no accounts, no telemetry.",
    "linux": {
      "deb": {
        "section": "editors",
        "priority": "optional"
      }
    },
    "resources": [
      "resources/wordlist.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
